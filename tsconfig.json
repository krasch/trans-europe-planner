{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "lib": [
      "es2022",
      "DOM"
    ],
    "paths": {
      "data/inputDataFormats.js": ["./data/inputDataFormats.js"],
      "script/*": ["./script/*"],
      "tests/*": ["./tests/*"],
      "style/*": ["./style/*"]
    }
  },
  "include": [
    "script/**/*.js",
    "tests/**/*.js",
    "tests/_helpers/domUtilsTypefix.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}