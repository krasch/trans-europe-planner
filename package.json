{
  "comment": "only using this for running tests&linting, not necessary for building the project",
  "name": "trans-europe-planner",
  "version": "0.1.",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "serve -p 8000",
    "test": "node --experimental-vm-modules node_modules/.bin/jest tests",
    "check-pretty": "npx prettier script/ style/planner/components/map/layers.js --check",
    "make-pretty": "npx prettier script/ style/planner/components/map/layers.js --write",
    "check-types": "npx tsc"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop-unit-testing": "^1.1.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "prettier": "3.3.3",
    "serve": "^14.2.4",
    "typescript": "^5.9.2"
  },
  "prettier": {
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "^external/(.*)$",
      "^script/(.*)$",
      "^tests/(.*)$",
      "^[./]"
    ],
    "importOrderSeparation": true
  },
  "jest": {
    "moduleNameMapper": {
      "external/(.*)": "<rootDir>/external/$1",
      "script/(.*)": "<rootDir>/script/$1",
      "style/(.*)": "<rootDir>/style/$1",
      "tests/(.*)": "<rootDir>/tests/$1"
    }
  }
}
