{
  "comment": "only using this for running tests&linting, not necessary for building the project",
  "name": "trans-europe-planner",
  "version": "0.1.",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "serve -p 8000",
    "test": "vitest run tests",
    "check-pretty": "npx prettier script/ style/planner/components/map/layers.js --check",
    "make-pretty": "npx prettier script/ style/planner/components/map/layers.js --write",
    "check-types": "npx tsc",
    "check": "npm run check-pretty && npm run check-types && npm run test"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^25.0.3",
    "prettier": "3.3.3",
    "serve": "^14.2.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "prettier": {
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "^external/(.*)$",
      "^script/(.*)$",
      "^tests/(.*)$",
      "^[./]"
    ],
    "importOrderSeparation": true
  },
  "dependencies": {
    "jsdom": "^27.3.0"
  }
}
